# Database
DATABASE_URL="postgresql://univershell:password@localhost:5432/univershell?schema=public"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Encryption key for sensitive data (32 bytes)
ENCRYPTION_KEY="your-32-byte-encryption-key-here-!"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:5173"

# PowerShell
POWERSHELL_TIMEOUT=300000

# OAuth for Delegated Authentication (user connections)
OAUTH_CLIENT_ID="your-oauth-app-client-id"
OAUTH_CLIENT_SECRET="your-oauth-app-client-secret"
OAUTH_REDIRECT_URI="http://localhost:3001/api/oauth/callback"

# Azure Key Vault (optional, for production)
# AZURE_KEY_VAULT_URL="https://your-vault.vault.azure.net/"
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# AZURE_TENANT_ID=""
